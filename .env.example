POSTGRES_DB=hemora
POSTGRES_USER=hemora
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://hemora:change-me@db:5432/hemora
JWT_SECRET=replace-with-at-least-32-random-characters
NATIONAL_ID_ENCRYPTION_KEY=replace-with-a-fernet-key
NATIONAL_ID_HMAC_KEY=replace-with-a-long-random-key
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api

# Relax only for automated end-to-end runs; keep strict in production.
LOGIN_RATE_LIMIT=10/minute
